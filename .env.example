# Copy to .env on the server and fill in. Never commit .env.

# Domain pointing at the server, e.g. pulse.example.lt
DOMAIN=pulse.example.lt

DJANGO_DEBUG=0
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=pulse.example.lt
PUBLIC_BASE_URL=https://pulse.example.lt

# Database password (any long random string)
POSTGRES_PASSWORD=
